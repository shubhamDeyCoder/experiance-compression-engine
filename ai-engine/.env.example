# Supabase project (never expose these to the browser).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Required to protect requests forwarded by the Next.js server.
AI_ENGINE_INTERNAL_KEY=replace-with-the-same-long-random-secret-as-the-web-app

# Required only by scheduled training and the CLI trainer.
# Do not set this in a publicly accessible browser or client application.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Persistent model artifacts and retraining policy.
AI_ENGINE_ARTIFACT_DIR=./ai-engine/artifacts
AI_ENGINE_MINIMUM_PER_CLASS=10
AI_ENGINE_MINIMUM_MACRO_F1=0.55
AI_ENGINE_RETRAIN_INTERVAL_HOURS=24
