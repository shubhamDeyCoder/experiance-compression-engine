# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side Anthropic key: scenario generation, rubric evaluation, and summaries.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional server-side embeddings for hybrid semantic + keyword retrieval.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Private URL and shared secret for the separately deployed Python service.
AI_ENGINE_SERVICE_URL=http://localhost:8000
AI_ENGINE_INTERNAL_KEY=replace-with-a-long-random-secret
